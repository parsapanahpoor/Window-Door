{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Panjerehyab: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Window.sln", "--configuration", "Debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Panjerehyab: verify",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1", "Verify"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Panjerehyab: run",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1", "Run"],
      "problemMatcher": "$msCompile"
    }
  ]
}
