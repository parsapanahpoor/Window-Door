@{
    Layout = null;
}
<!DOCTYPE HTML>
<html lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>پنجره یاب |مرجع رسمی قیمت گذاری درب و پنجره</title>
    <!-- Modernizr -->
    <!-- <script src="/Landing/js/modernizr.js"></script> -->
    <!-- Open Sans from Google Webfonts -->
    <!-- <link href='http://fonts.googleapis.com/css?family=Open+Sans:400,300' rel='stylesheet' type='text/css'> -->
    <!-- Main styles file -->
    <link rel="shortcut icon" href="/admin/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="/Landing/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Landing/css/styles.css" />
    <link rel="stylesheet" href="/Landing/css/component.css" />
    <!-- Icons via Font Awesome -->
    <link rel="stylesheet" href="/Landing/css/font-awesome.min.css" />

    @*Manifest*@
    <link rel="manifest" href="~/Site/Manifest/manifest.json">

    <!-- #94151D,#EF394E -->
    <style>
        .splash { min-width: 0; }
        .splash .centered-unit {
            position: relative;
            top: auto;
            margin-top: 0;
            padding: 48px 0;
        }
        .landing-cards {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 24px;
            max-width: 960px;
            margin: 32px auto;
            direction: rtl;
        }
        .landing-card {
            display: block;
            min-width: 0;
            box-sizing: border-box;
            text-align: center;
            text-decoration: none;
        }
        .landing-card-image {
            display: block;
            overflow: hidden;
            border: 5px solid #fff;
            border-radius: 24px;
            background: #fff;
        }
        .landing-card img {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 1;
            object-fit: cover;
            box-sizing: border-box;
            border: 0;
        }
        .landing-card h2::before { content: none; }
        .landing-card h2 {
            margin: 16px 0 0;
            font-size: 20px;
            line-height: 1.7;
        }
        a.landing-card:focus-visible {
            outline: 3px solid #ffba45;
            outline-offset: 6px;
            border-radius: 18px;
        }
        .landing-card-disabled img { filter: grayscale(1); }
        .landing-card-disabled h2 { color: #d6d6d6; }
        @@media (max-width: 640px) {
            .landing-cards {
                grid-template-columns: 1fr;
                max-width: 320px;
                gap: 28px;
                padding: 0 16px;
            }
        }
    </style>
</head>
<body class="color-scheme-sky">
    <!-- Animated background -->
    <canvas id="bg-canvas"></canvas>
    <!--  -->
    <!-- First screen -->
    <div class="splash">
        <div class="centered-unit">
            <div class="container">
                <!-- Main header -->
                <h1 class="title_header">پنجره یاب</h1>
                <!-- Sub header -->
                <p class="lead"> مرجع قیمت گذاری درب و پنجره در ایران</p>
                <nav class="landing-cards" aria-label="بخش‌های پنجره‌یاب">
                    <a class="landing-card" asp-area="" asp-controller="Shop" asp-action="ShopLanding">
                        <span class="landing-card-image"><img src="/Landing/images/7.jpg" asp-append-version="true" alt="" width="1254" height="1254"></span>
                        <h2>فروشگاه</h2>
                    </a>
                    <a class="landing-card" asp-area="" asp-controller="InquiryProduct" asp-action="InquiryStep1">
                        <span class="landing-card-image"><img src="/Landing/images/1.jpg" asp-append-version="true" alt="" width="853" height="860"></span>
                        <h2>استعلام رایگان</h2>
                    </a>
                    <div class="landing-card landing-card-disabled" aria-disabled="true">
                        <span class="landing-card-image"><img src="/Landing/images/3.jpg" asp-append-version="true" alt="" width="853" height="860"></span>
                        <h2>دستیار هوشمند پنجره یاب</h2>
                    </div>
                </nav>
            </div>
        </div>

    </div>


    <!-- JavaScripts -->
    <script src="/Landing/js/jquery.js"></script>
    <!-- <script src="/Landing/js/countdown.js"></script> -->
    <script src="/Landing/js/bezierCanvas.js"></script>
    <script src="/Landing/js/notifyMe.js"></script>
    <script src="/Landing/js/modernizr.custom.js"></script>

    @*PWA Downloader Confige*@
    <script src="~/Site/js/PWADownloader.js"></script>

    @foreach (var key in new[] { "SuccessMessage", "ErrorMessage", "WarningMessage", "InfoMessage" })
    {
        if (TempData[key] is string message)
        {
            <div role="status" style="position:relative;z-index:2;text-align:center;background:#fff;color:#222;padding:12px">@message</div>
        }
    }
    <!-- <script src="/Landing/js/toucheffects.js"></script> -->
    <script type="text/javascript">
        $().ready(function () {

            // Activate countdownTimer plugin on a '.countdown' element
            // $(".countdown").countdownTimer({
            // 	// Set the end date for the countdown
            // 	endTime: new Date("April 21, 2014 11:13:00 UTC+0200")
            // });


            // Activate notifyMe plugin on a '#notifyMe' element
            $("#notifyMe").notifyMe();


            // Activate bezierCanvas plugin on a #bg-canvas element
            $("#bg-canvas").bezierCanvas({
                maxStyles: 1,
                maxLines: 100,
                lineSpacing: 0.5,
                colorBase: { r: 255, g: 255, b: 255 },
                colorVariation: { r: 0, g: 0, b: 0 },
                delayVariation: 0,
                speedLinear: true,
                globalAlpha: 0.7,
                globalSpeed: 500,
            });

            // Add handler on 'Scroll down to learn more' link
            // $().ready(function(){
            // 	$(".overlap .more").click(function(e){
            // 		e.preventDefault();
            // 		$("body,html").animate({scrollTop: $(window).height()});
            // 	});
            // });


        });
    </script>
</body>
</html>