@model Window.Domain.ViewModels.User.Authentication.RegisterUserViewModel
@{
    ViewData["Title"] = "ثبت‌نام";
    ViewData["AccountArt"] = "door";
    Layout = "Identity/_AccountLayout";
}
<div class="account-heading">
    <p class="account-kicker">حساب کاربری</p>
    <h1 id="account-title">ساخت حساب کاربری</h1>
    <p>شمارهٔ موبایل و رمز عبورت را وارد کن.</p>
</div>
<form asp-action="Register" method="post" class="account-form">
    <div asp-validation-summary="All" class="account-errors" role="alert"></div>
    <div class="account-field">
        <label asp-for="Mobile">شماره موبایل</label>
        <input asp-for="Mobile" type="tel" dir="ltr" autocomplete="username" placeholder="09123456789" required />
    </div>
    <div class="account-field">
        <label asp-for="Password">رمز عبور</label>
        <div class="account-password">
            <input asp-for="Password" dir="ltr" autocomplete="new-password" minlength="4" required />
            <button type="button" data-password-toggle hidden>نمایش</button>
        </div>
    </div>
    <div class="account-field">
        <label asp-for="RePassword">تکرار رمز عبور</label>
        <input asp-for="RePassword" dir="ltr" autocomplete="new-password" minlength="4" required />
    </div>
    <button class="account-submit" type="submit">ثبت‌نام</button>
</form>
<p class="account-footer">حساب داری؟ <a asp-action="Login">ورود</a></p>
