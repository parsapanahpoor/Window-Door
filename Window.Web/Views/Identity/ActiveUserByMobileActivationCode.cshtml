@using Window.Web.Culture
@model Window.Domain.ViewModels.Site.Account.ActiveMobileByActivationCodeViewModel
@{
    ViewData["Title"] = "فعال‌سازی حساب کاربری";
    ViewData["AccountArt"] = "door";
    Layout = "Identity/_AccountLayout";
    var seconds = ViewBag.Time is double value ? (int)Math.Max(0, value) : 120;
    var mobile = ViewBag.Mobile as string ?? Model?.Mobile;
}
<div class="account-heading">
    <p class="account-kicker">تأیید شماره موبایل</p>
    <h1 id="account-title">کد تأیید را وارد کن</h1>
    <p>کد شش‌رقمی به شمارهٔ <bdi dir="ltr">@mobile</bdi> فرستاده شد. تأیید شماره حساب را برای ورود فعال می‌کند؛ فعال‌شدن فروشگاه جداگانه و پس از تکمیل اطلاعات است.</p>
</div>
<form method="post" asp-action="ActiveUserByMobileActivationCode" asp-route-Mobile="@mobile" class="account-form">
    <div asp-validation-summary="All" class="account-errors" role="alert"></div>
    <input type="hidden" asp-for="Mobile" value="@mobile" />
    <div class="account-field">
        <label asp-for="MobileActiveCode">کد تأیید پیامکی</label>
        <input asp-for="MobileActiveCode" inputmode="numeric" dir="ltr" autocomplete="one-time-code"
               maxlength="6" required placeholder="۱۲۳۴۵۶" />
        <span asp-validation-for="MobileActiveCode" class="text-danger"></span>
    </div>
    <button class="account-submit" type="submit">تأیید و ورود</button>
</form>
<p class="account-footer" id="resend-area" aria-live="polite">
    <span id="resend-timer" data-seconds="@seconds">ارسال مجدد تا @seconds ثانیهٔ دیگر</span>
    <a id="resend-link"
       asp-action="ActiveUserByMobileActivationCode" asp-route-Mobile="@mobile" asp-route-Resend="true"
       hidden>ارسال مجدد کد</a>
</p>
<script>
    (() => {
        const timer = document.getElementById('resend-timer');
        const link = document.getElementById('resend-link');
        if (!timer || !link) return;
        let seconds = Number(timer.dataset.seconds) || 0;
        const render = () => {
            if (seconds > 0) {
                timer.textContent = 'ارسال مجدد تا ' + seconds + ' ثانیهٔ دیگر';
                timer.hidden = false;
                link.hidden = true;
            } else {
                timer.hidden = true;
                link.hidden = false;
            }
        };
        render();
        if (seconds > 0) {
            const id = setInterval(() => {
                seconds--;
                render();
                if (seconds <= 0) clearInterval(id);
            }, 1000);
        }
    })();
</script>
