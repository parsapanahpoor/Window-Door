@model Window.Domain.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "تعیین رمز عبور جدید";
    ViewData["AccountArt"] = "door";
    Layout = "Identity/_AccountLayout";
    var mobile = ViewBag.Mobile as string;
    var seconds = Convert.ToInt32(ViewBag.Time ?? 0);
}
<div class="account-heading">
    <p class="account-kicker">بازیابی حساب · مرحلهٔ ۲ از ۲</p>
    <h1 id="account-title">تعیین رمز عبور جدید</h1>
    <p>کد پیامک‌شده و رمز عبور جدیدت را وارد کن.</p>
</div>
<form asp-action="ResetPassword" asp-route-mobile="@mobile" method="post" class="account-form">
    <div asp-validation-summary="All" class="account-errors" role="alert"></div>
    <div class="account-field">
        <label asp-for="ActiveCode">کد بازیابی</label>
        <input asp-for="ActiveCode" dir="ltr" inputmode="numeric" autocomplete="one-time-code" required />
    </div>
    <div class="account-field">
        <label asp-for="Password">رمز عبور جدید</label>
        <div class="account-password">
            <input asp-for="Password" dir="ltr" autocomplete="new-password" required />
            <button type="button" data-password-toggle hidden>نمایش</button>
        </div>
    </div>
    <div class="account-field">
        <label asp-for="ConfirmPassword">تکرار رمز عبور جدید</label>
        <input asp-for="ConfirmPassword" dir="ltr" autocomplete="new-password" required />
    </div>
    <button class="account-submit" type="submit">ذخیرهٔ رمز عبور</button>
</form>
<form asp-action="ForgotPassword" method="post" id="resendPasswordCode" class="account-resend" data-resend-seconds="@seconds">
    <input type="hidden" name="Mobile" value="@mobile" />
    <button type="submit" form="resendPasswordCode" id="SMS" class="account-link">ارسال مجدد کد</button>
    <span data-resend-label hidden>ارسال مجدد تا <bdi data-resend-time></bdi></span>
</form>
<p class="account-footer"><a asp-action="ForgotPassword">تغییر شماره موبایل</a> <span aria-hidden="true">·</span> <a asp-action="Login">بازگشت به ورود</a></p>
