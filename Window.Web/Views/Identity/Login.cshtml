@model Window.Domain.ViewModels.User.Authentication.LoginUserViewModel
@{
    ViewData["Title"] = "ورود با کلمهٔ عبور";
    Layout = "Identity/_AccountLayout";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<div class="account-heading">
    <p class="account-kicker">حساب کاربری</p>
    <h1 id="account-title">ورود به پنجره‌یاب</h1>
</div>
<nav class="account-methods" aria-label="روش ورود">
    <a asp-action="Login" asp-route-returnUrl="@returnUrl">ورود با کد پیامکی</a>
    <a asp-action="PasswordLogin" asp-route-returnUrl="@returnUrl" aria-current="page">ورود با کلمهٔ عبور</a>
</nav>
<form asp-action="PasswordLogin" asp-route-returnUrl="@returnUrl" method="post" class="account-form">
    <div asp-validation-summary="All" class="account-errors" role="alert"></div>
    <div class="account-field">
        <label asp-for="Mobile">شماره موبایل</label>
        <input asp-for="Mobile" type="tel" dir="ltr" autocomplete="username" placeholder="09123456789" required />
    </div>
    <div class="account-field">
        <div class="account-field-top">
            <label asp-for="Password">کلمهٔ عبور</label>
            <a asp-action="ForgotPassword">رمز را فراموش کرده‌ام</a>
        </div>
        <div class="account-password">
            <input asp-for="Password" dir="ltr" autocomplete="current-password" required />
            <button type="button" data-password-toggle hidden>نمایش</button>
        </div>
    </div>
    <label class="account-check"><input asp-for="RememberMe" /> مرا به خاطر بسپار</label>
    <button class="account-submit" type="submit">ورود</button>
</form>
<p class="account-footer">حساب نداری؟ <a asp-action="Register">ثبت‌نام</a></p>
