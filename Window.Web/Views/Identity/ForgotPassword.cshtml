@model Window.Domain.ViewModels.Account.ForgetPasswordViewModel
@{
    ViewData["Title"] = "فراموشی رمز عبور";
    Layout = "Identity/_AccountLayout";
}
<div class="account-heading">
    <p class="account-kicker">بازیابی حساب · مرحلهٔ ۱ از ۲</p>
    <h1 id="account-title">رمز عبورت را فراموش کردی؟</h1>
    <p>شمارهٔ موبایل حسابت را وارد کن تا کد بازیابی را برایت بفرستیم.</p>
</div>
<form asp-action="ForgotPassword" method="post" class="account-form">
    <div asp-validation-summary="All" class="account-errors" role="alert"></div>
    <div class="account-field">
        <label asp-for="Mobile">شماره موبایل</label>
        <input asp-for="Mobile" type="tel" dir="ltr" autocomplete="tel" placeholder="09123456789" required />
    </div>
    <button class="account-submit" type="submit">ارسال کد بازیابی</button>
</form>
<p class="account-footer"><a asp-action="Login">بازگشت به ورود</a></p>
