@using Window.Application.StticTools
@using Window.Domain.Entities.Market
@using Window.Domain.ViewModels.Common
@model Window.Domain.ViewModels.Seller.PersonalInfo.ListOfPersonalInfoViewModel

@{
    ViewData["Title"] = "اطلاعات شخصی فروشگاه";
}

@section Styles {
    <link rel="stylesheet" href="~/css/seller-profile.css" asp-append-version="true" />
}

@section Breadcrumb {
    <li aria-current="page">@ViewData["Title"]</li>
}

@section Scripts {
    <script src="~/lib/Custom/SellerPersonalInfo.js" asp-append-version="true"></script>
    <script src="~/js/seller-profile.js" asp-append-version="true"></script>
    <partial name="_JqueryValidation" />
}

<div class="seller-profile">
    @if (Model.MarketPersonalsInfoState == MarketPersonalsInfoState.Rejected && !string.IsNullOrWhiteSpace(Model.RejectedNote))
    {
        <section class="seller-profile-card seller-profile-feedback">
            <h2>پیام پشتیبانی</h2>
            <p>@Model.RejectedNote</p>
        </section>
    }

    <form asp-action="UpdateSellerPersonlInfo" method="post" enctype="multipart/form-data" class="seller-profile-card">
        <h2>مشخصات فروشگاه</h2>
        <p>اطلاعات ثبت‌شده را می‌توانید ویرایش کنید. برای حفظ تصاویر قبلی، فایل جدیدی انتخاب نکنید.</p>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="seller-profile-fields">
            <div>
                <label asp-for="NationalCode"></label>
                <input asp-for="NationalCode" class="form-control" type="text" inputmode="numeric" dir="ltr" />
                <span asp-validation-for="NationalCode" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="SellerType">نوع فروشنده</label>
                <select asp-for="SellerType" class="form-control" asp-items="Html.GetEnumSelectList<Window.Domain.Enums.SellerType.SellerType>()"></select>
                <span asp-validation-for="SellerType" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="CompanyName"></label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="PeriodTimesOfWork"></label>
                <input asp-for="PeriodTimesOfWork" class="form-control" />
                <span asp-validation-for="PeriodTimesOfWork" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="CountryId"></label>
                <select asp-for="CountryId" class="form-control" asp-items="@(new SelectList((IEnumerable<SelectListViewModel>)ViewData["Countries"], "Id", "Title"))">
                    <option value="">انتخاب کنید</option>
                </select>
                <span asp-validation-for="CountryId" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="StateId"></label>
                <select asp-for="StateId" class="form-control" asp-items="@(new SelectList((IEnumerable<SelectListViewModel>)ViewData["States"], "Id", "Title"))">
                    <option value="">انتخاب کنید</option>
                </select>
                <span asp-validation-for="StateId" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="CityId"></label>
                <select asp-for="CityId" class="form-control" asp-items="@(new SelectList((IEnumerable<SelectListViewModel>)ViewData["Cities"], "Id", "Title"))">
                    <option value="">انتخاب کنید</option>
                </select>
                <span asp-validation-for="CityId" class="text-danger"></span>
            </div>
            <div class="seller-profile-wide">
                <label asp-for="Resume"></label>
                <textarea asp-for="Resume" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Resume" class="text-danger"></span>
            </div>
            <div class="seller-profile-wide">
                <label asp-for="WorkAddress"></label>
                <textarea asp-for="WorkAddress" class="form-control" rows="3"></textarea>
                <span asp-validation-for="WorkAddress" class="text-danger"></span>
            </div>
        </div>
        <p id="seller-location-status" role="status"></p>
        <h2>تصاویر و مدارک</h2>
        <div class="seller-profile-documents">
            <div class="seller-document">
                <label asp-for="ImageOfNationalCode" class="seller-document-title">
                    <i class="fa fa-id-card-o" aria-hidden="true"></i> عکس کارت ملی
                </label>
                <div class="seller-document-preview">
                    <img src="@(string.IsNullOrEmpty(Model.PhotoOfNationalCode) ? null : FilePaths.SellerInfoPath + Model.PhotoOfNationalCode)"
                         alt="عکس کارت ملی" ImageFile="1" />
                    <span class="seller-document-empty"><i class="fa fa-id-card-o" aria-hidden="true"></i> پیش‌نمایش تصویر</span>
                </div>
                <div class="seller-document-picker">
                    <i class="fa fa-upload" aria-hidden="true"></i>
                    <span aria-hidden="true">انتخاب تصویر</span>
                    <input asp-for="ImageOfNationalCode" type="file" accept=".jpg,.jpeg,.png" ImageInput="1"
                           aria-describedby="ImageOfNationalCode-hint" />
                </div>
                <small id="ImageOfNationalCode-hint" class="seller-document-hint" aria-live="polite">JPG یا PNG</small>
                <span asp-validation-for="ImageOfNationalCode" class="text-danger"></span>
            </div>
            <div class="seller-document">
                <label asp-for="ImageOfBusinessLicense" class="seller-document-title">
                    <i class="fa fa-file-text-o" aria-hidden="true"></i> عکس جواز کسب
                </label>
                <div class="seller-document-preview">
                    <img src="@(string.IsNullOrEmpty(Model.PhotoOfBusinessLicense) ? null : FilePaths.SellerInfoPath + Model.PhotoOfBusinessLicense)"
                         alt="عکس جواز کسب" ImageFile="2" />
                    <span class="seller-document-empty"><i class="fa fa-file-text-o" aria-hidden="true"></i> پیش‌نمایش تصویر</span>
                </div>
                <div class="seller-document-picker">
                    <i class="fa fa-upload" aria-hidden="true"></i>
                    <span aria-hidden="true">انتخاب تصویر</span>
                    <input asp-for="ImageOfBusinessLicense" type="file" accept=".jpg,.jpeg,.png" ImageInput="2"
                           aria-describedby="ImageOfBusinessLicense-hint" />
                </div>
                <small id="ImageOfBusinessLicense-hint" class="seller-document-hint" aria-live="polite">JPG یا PNG</small>
                <span asp-validation-for="ImageOfBusinessLicense" class="text-danger"></span>
            </div>
            <div class="seller-document">
                <label asp-for="ImageCompanyLogo" class="seller-document-title">
                    <i class="fa fa-picture-o" aria-hidden="true"></i> لوگوی شرکت
                </label>
                <div class="seller-document-preview">
                    <img src="@(string.IsNullOrEmpty(Model.CompanyLogo) ? null : FilePaths.SellerInfoPath + Model.CompanyLogo)"
                         alt="لوگوی شرکت" ImageFile="3" />
                    <span class="seller-document-empty"><i class="fa fa-picture-o" aria-hidden="true"></i> پیش‌نمایش تصویر</span>
                </div>
                <div class="seller-document-picker">
                    <i class="fa fa-upload" aria-hidden="true"></i>
                    <span aria-hidden="true">انتخاب تصویر</span>
                    <input asp-for="ImageCompanyLogo" type="file" accept=".jpg,.jpeg,.png" ImageInput="3"
                           aria-describedby="ImageCompanyLogo-hint" />
                </div>
                <small id="ImageCompanyLogo-hint" class="seller-document-hint" aria-live="polite">JPG یا PNG</small>
                <span asp-validation-for="ImageCompanyLogo" class="text-danger"></span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary seller-profile-save">ذخیرهٔ تغییرات</button>
    </form>


    <section class="seller-profile-card seller-related-card" aria-labelledby="seller-work-samples-title">
        <header class="seller-related-header">
            <div class="seller-related-heading-copy">
                <span class="seller-related-icon" aria-hidden="true"><i class="fa fa-briefcase"></i></span>
                <div>
                    <h2 id="seller-work-samples-title">نمونه‌کارها</h2>
                    <p>نمونه‌کارهای ثبت‌شدهٔ فروشگاه را مدیریت کنید.</p>
                </div>
            </div>
            <button type="button" onclick="LoadAddPersonalWorkSampleModalBody()" class="seller-related-add">
                <i class="fa fa-plus" aria-hidden="true"></i><span>افزودن نمونه‌کار</span>
            </button>
        </header>

        @if (Model.MarketWorkSamples != null && Model.MarketWorkSamples.Any())
        {
            <div class="seller-table-viewport">
                <table class="seller-related-table seller-work-sample-table">
                    <caption class="sr-only">نمونه‌کارهای ثبت‌شدهٔ فروشگاه</caption>
                    <thead>
                        <tr>
                            <th scope="col">تصویر نمونه‌کار</th>
                            <th scope="col">عنوان نمونه‌کار</th>
                            <th scope="col">مدیریت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var link in Model.MarketWorkSamples)
                        {
                            <tr class="seller-work-sample-row" id="sample_@link.Id" remove-ajax-item="sample_@link.Id">
                                <td class="seller-sample-image-cell" data-label="تصویر نمونه‌کار">
                                    @if (!string.IsNullOrWhiteSpace(link.WorkSampleImage))
                                    {
                                        <img src="/content/images/SellerInfo/thumb/@link.WorkSampleImage" alt="@link.WorkSampleTitle" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="seller-sample-placeholder" aria-label="تصویری ثبت نشده"><i class="fa fa-picture-o" aria-hidden="true"></i></span>
                                    }
                                </td>
                                <td class="seller-sample-title-cell" data-label="عنوان نمونه‌کار"><strong>@link.WorkSampleTitle</strong></td>
                                <td class="seller-related-actions-cell" data-label="مدیریت">
                                    <button type="button" aria-label="حذف نمونه‌کار @link.WorkSampleTitle" title="حذف نمونه‌کار"
                                            onclick="DeleteAjax('sample_@link.Id', '@Url.Action("DeleteWorkSample", "SellerPersonalInfo", new {area = "Seller", id = link.Id})')"
                                            class="seller-table-action seller-table-delete"><i class="fa fa-trash" aria-hidden="true"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="seller-table-empty">
                <span class="seller-related-icon" aria-hidden="true"><i class="fa fa-picture-o"></i></span>
                <strong>هنوز نمونه‌کاری ثبت نشده است</strong>
                <p>با افزودن نمونه‌کار، تجربه و کیفیت کارتان را به مشتریان نشان دهید.</p>
            </div>
        }
    </section>

    <section class="seller-profile-card seller-related-card" aria-labelledby="seller-links-title">
        <header class="seller-related-header">
            <div class="seller-related-heading-copy">
                <span class="seller-related-icon seller-links-icon" aria-hidden="true"><i class="fa fa-link"></i></span>
                <div>
                    <h2 id="seller-links-title">لینک‌های ارتباطی</h2>
                    <p>راه‌های ارتباط و حضور آنلاین فروشگاه را مدیریت کنید.</p>
                </div>
            </div>
            <button type="button" onclick="LoadAddPersonalLinkModalBody()" class="seller-related-add">
                <i class="fa fa-plus" aria-hidden="true"></i><span>ثبت لینک جدید</span>
            </button>
        </header>

        @if (Model.MarketLinks != null && Model.MarketLinks.Any())
        {
            <div class="seller-table-viewport">
                <table class="seller-related-table seller-link-table">
                    <caption class="sr-only">لینک‌های ارتباطی فروشگاه</caption>
                    <thead>
                        <tr>
                            <th scope="col">عنوان لینک</th>
                            <th scope="col">آدرس لینک</th>
                            <th scope="col">مدیریت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sellerLinks in Model.MarketLinks)
                        {
                            <tr class="seller-link-row" id="link_@sellerLinks.Id" remove-ajax-item="link_@sellerLinks.Id">
                                <td class="seller-link-title-cell" data-label="عنوان لینک"><strong>@sellerLinks.LinkTitle</strong></td>
                                <td class="seller-link-value-cell" data-label="آدرس لینک"><bdi dir="ltr">@sellerLinks.LinkValue</bdi></td>
                                <td class="seller-related-actions-cell" data-label="مدیریت">
                                    <button type="button" aria-label="حذف لینک @sellerLinks.LinkTitle" title="حذف لینک"
                                            onclick="DeleteAjax('link_@sellerLinks.Id', '@Url.Action("DeleteSellersLinks", "SellerPersonalInfo", new {area = "Seller", id = sellerLinks.Id})')"
                                            class="seller-table-action seller-table-delete"><i class="fa fa-trash" aria-hidden="true"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="seller-table-empty">
                <span class="seller-related-icon seller-links-icon" aria-hidden="true"><i class="fa fa-link"></i></span>
                <strong>هنوز لینک ارتباطی ثبت نشده است</strong>
                <p>راه‌های ارتباطی خود را اضافه کنید تا مشتریان راحت‌تر با شما در تماس باشند.</p>
            </div>
        }
    </section>
    </div>
