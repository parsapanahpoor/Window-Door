@model Window.Domain.ViewModels.Seller.PersonalInfo.AddSellerWorkSampleViewModel

<form id="PersonalWorkSampleForm" method="post" asp-action="AddPersonalWorkInSampleInModal" asp-controller="SellerPersonalInfo" asp-area="Seller" enctype="multipart/form-data" data-ajax="true" data-ajax-success="PersonalWorkSampleFormSubmited">
    <input type="hidden" asp-for="WorkSampleImage" id="Avatar" />
    <div class="seller-sample-modal-form">
        <div class="seller-modal-field">
            <label asp-for="WorkSampleTitle"></label>
            <input asp-for="WorkSampleTitle" class="form-control" autocomplete="off" />
            <span asp-validation-for="WorkSampleTitle" class="text-danger"></span>
        </div>

        <div class="seller-modal-upload-field">
            <label for="image">تصویر نمونه‌کار</label>
            <div class="seller-modal-upload-layout">
                <div class="seller-modal-image-preview">
                    <img id="SellerWorkSamplePreview" alt="پیش‌نمایش نمونه‌کار" hidden />
                    <span id="SellerWorkSamplePlaceholder"><i class="fa fa-picture-o" aria-hidden="true"></i> پیش‌نمایش تصویر</span>
                </div>
                <label class="seller-document-picker">
                    <i class="fa fa-upload" aria-hidden="true"></i>
                    <span>انتخاب تصویر</span>
                    <input type="file" name="image" id="image" accept=".jpg,.jpeg,.png,image/jpeg,image/png" aria-describedby="SellerWorkSampleImageHint SellerWorkSampleUploadStatus" />
                </label>
            </div>
            <small id="SellerWorkSampleImageHint" class="seller-document-hint">فقط تصویر JPG یا PNG</small>
            <small id="SellerWorkSampleUploadStatus" class="seller-modal-upload-status" role="status" aria-live="polite"></small>
        </div>

        <div class="seller-modal-form-actions">
            <button type="submit" class="seller-related-add"><i class="fa fa-check" aria-hidden="true"></i><span>ثبت نمونه‌کار</span></button>
            <button type="button" class="seller-modal-cancel" data-dismiss="modal">بستن</button>
        </div>
    </div>
</form>