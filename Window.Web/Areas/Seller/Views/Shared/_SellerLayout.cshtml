@{
    var culture = ApplicationCultures.GetCurrentCulture();
    var isDashboard = ViewData["SellerDashboard"] is true;
}
<!DOCTYPE html>
<html lang="@culture.CultureKey" dir="@culture.Direction">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <partial name="_SellerHeaderReferences" />
    <link rel="stylesheet" href="~/css/seller-shell.css" asp-append-version="true" />
    @RenderSection("Styles", false)
</head>
<body class="seller-shell @(isDashboard ? "seller-dashboard-shell" : null)">
    @await Component.InvokeAsync("SellerNavbar")
    <partial name="_SellerNavigation" />
    <div class="main-container container-fluid">
        <div class="page-container">
            <div class="page-content seller-page-content">
                <div class="page-breadcrumbs">
                    <ul class="breadcrumb">
                        <li>
                            <i class="fa fa-home" aria-hidden="true"></i>
                            <a asp-area="Seller" asp-controller="Home" asp-action="Index">@SharedLocalizer["Home"]</a>
                        </li>
                        @RenderSection("breadcrumb", true)
                    </ul>
                </div>
                <partial name="_SellerPageHeader" />
                <div class="page-body seller-page-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <partial name="_SellerFooterReferences" />
    <partial name="_Notification" />
    <partial name="_SweetAlertLocalizer" />
    <partial name="_Modals" />
    @RenderSection("Scripts", false)
</body>
</html>
