@inject IStringLocalizer<SellerDashboardText> DashboardText

<section aria-labelledby="seller-shortcuts-title">
    <h2 id="seller-shortcuts-title">@DashboardText["Quick access"]</h2>
    <div class="seller-shortcuts">
        <a class="seller-shortcut" asp-area="Seller" asp-controller="Ticket" asp-action="FilterTickets">
            <i class="fa fa-ticket" aria-hidden="true"></i><span>@DashboardText["Support tickets"]</span>
        </a>
        <a class="seller-shortcut" asp-area="Seller" asp-controller="Account" asp-action="EditProfile">
            <i class="fa fa-user" aria-hidden="true"></i><span>@DashboardText["Edit profile"]</span>
        </a>
        <a class="seller-shortcut" asp-area="Seller" asp-controller="ShopOrder" asp-action="ManageOrderPage">
            <i class="fa fa-shopping-cart" aria-hidden="true"></i><span>@DashboardText["Manage orders"]</span>
        </a>
        <a class="seller-shortcut" asp-area="Seller" asp-controller="OrderCheque" asp-action="ManageOrderChequesPages">
            <i class="fa fa-credit-card" aria-hidden="true"></i><span>@DashboardText["Manage cheques"]</span>
        </a>
        @if (ViewBag.SellerMastert == true)
        {
            <a class="seller-shortcut" asp-area="Seller" asp-controller="User" asp-action="Index">
                <i class="fa fa-users" aria-hidden="true"></i><span>@DashboardText["Employees"]</span>
            </a>
            <a class="seller-shortcut" asp-area="Seller" asp-controller="User" asp-action="AddNewUser">
                <i class="fa fa-user-plus" aria-hidden="true"></i><span>@DashboardText["Add employee"]</span>
            </a>
            <a class="seller-shortcut" asp-area="Seller" asp-controller="SellerPersonalInfo" asp-action="PageOfManageSellerInformation">
                <i class="fa fa-cog" aria-hidden="true"></i><span>@DashboardText["Store information"]</span>
            </a>
            @if (ViewBag.SellersInfosState == "ActiveSellerAccount")
            {
                <a class="seller-shortcut" asp-area="Seller" asp-controller="Contarct" asp-action="ListOfContracts">
                    <i class="fa fa-file-text-o" aria-hidden="true"></i><span>@DashboardText["Contract requests"]</span>
                </a>
                <a class="seller-shortcut" asp-area="Seller" asp-controller="Product" asp-action="FilterProducts">
                    <i class="fa fa-list-ul" aria-hidden="true"></i><span>@DashboardText["Inquiry products"]</span>
                </a>
                <a class="seller-shortcut" asp-area="Seller" asp-controller="Product" asp-action="CreateProduct">
                    <i class="fa fa-plus" aria-hidden="true"></i><span>@DashboardText["Add inquiry product"]</span>
                </a>
                <a class="seller-shortcut" asp-area="Seller" asp-controller="Product" asp-action="CreateGlassPricing">
                    <i class="fa fa-th-large" aria-hidden="true"></i><span>@DashboardText["Glass pricing"]</span>
                </a>
                <a class="seller-shortcut" asp-area="Seller" asp-controller="ShopProduct" asp-action="FilterShopProducts">
                    <i class="fa fa-cubes" aria-hidden="true"></i><span>@DashboardText["Store products"]</span>
                </a>
                <a class="seller-shortcut" asp-area="Seller" asp-controller="ShopProduct" asp-action="CreateProduct">
                    <i class="fa fa-plus-square" aria-hidden="true"></i><span>@DashboardText["Add store product"]</span>
                </a>
            }
        }
    </div>
</section>
