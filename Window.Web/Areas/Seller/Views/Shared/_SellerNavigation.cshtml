@inject IStringLocalizer<SellerDashboardText> Text

@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    var dashboard = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "Index", StringComparison.OrdinalIgnoreCase);
    var orders = string.Equals(controller, "ShopOrder", StringComparison.OrdinalIgnoreCase)
        || string.Equals(controller, "OrderCheque", StringComparison.OrdinalIgnoreCase);
    var support = string.Equals(controller, "Ticket", StringComparison.OrdinalIgnoreCase);
    var orderPage = string.Equals(controller, "ShopOrder", StringComparison.OrdinalIgnoreCase)
        && string.Equals(action, "ManageOrderPage", StringComparison.OrdinalIgnoreCase);
    var supportPage = support && string.Equals(action, "FilterTickets", StringComparison.OrdinalIgnoreCase);
}

<nav class="seller-navigation" aria-label="@Text["Seller navigation"]">
    <div class="seller-navigation-inner">
        <a asp-area="Seller" asp-controller="Home" asp-action="Index" aria-current="@(dashboard ? "page" : null)">
            <i class="fa fa-th-large" aria-hidden="true"></i><span>@Text["Dashboard"]</span>
        </a>
        <a asp-area="Seller" asp-controller="ShopOrder" asp-action="ManageOrderPage"
           aria-current="@(orderPage ? "page" : orders ? "true" : null)">
            <i class="fa fa-shopping-cart" aria-hidden="true"></i><span>@Text["Orders"]</span>
        </a>
        <a asp-area="Seller" asp-controller="Ticket" asp-action="FilterTickets"
           aria-current="@(supportPage ? "page" : support ? "true" : null)">
            <i class="fa fa-ticket" aria-hidden="true"></i><span>@Text["Support"]</span>
        </a>
    </div>
</nav>
